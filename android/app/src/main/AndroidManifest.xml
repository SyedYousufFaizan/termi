<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <!-- Required for foreground service to keep terminal alive -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    
    <!-- Wake lock for long-running operations -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- Internet for package downloads (Month 3) -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Vibration for haptic feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />
    
    <!-- POST_NOTIFICATIONS for Android 13+ foreground service -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".TerminalApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_terminal"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_terminal"
        android:supportsRtl="true"
        android:theme="@style/Theme.Terminal"
        tools:targetApi="34">
        
        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|screenSize|smallestScreenSize|screenLayout|orientation"
            android:theme="@style/Theme.Terminal">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Terminal Foreground Service -->
        <service
            android:name=".core.TerminalService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="terminal_emulator" />
        </service>
        
        <!-- SAF Document Provider for file picker integration -->
        <provider
            android:name=".storage.SafBridge"
            android:authorities="${applicationId}.safbridge"
            android:enabled="true"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>

</manifest>
